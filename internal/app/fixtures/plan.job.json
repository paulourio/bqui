   "query": "WITH w AS (SELECT word, corpus, word_count, ROW_NUMBER() OVER (PARTITION BY corpus ORDER BY word_count DESC) AS rk FROM `bigquery-public-data.samples.shakespeare`), nc AS (SELECT word, COUNT(DISTINCT corpus) AS n FROM `bigquery-public-data.samples.shakespeare` GROUP BY word), top AS (SELECT corpus, ARRAY_AGG(word ORDER BY rk LIMIT 5) AS words FROM w WHERE rk <= 5 GROUP BY corpus), common AS (SELECT word FROM nc WHERE n > 30) SELECT t.corpus, ANY_VALUE(t.words) AS words, COUNT(DISTINCT c.word) AS shared, APPROX_QUANTILES(w.word_count, 4) AS q FROM top t JOIN w ON w.corpus = t.corpus JOIN common c ON c.word = w.word GROUP BY t.corpus ORDER BY shared DESC",
